HOST=127.0.0.1
PORT=4000
DATABASE_URL=sqlite://data/amnezia-panel.db
COOKIE_SECURE=false
# preview = metadata only; host = Linux wg-quick / awg-quick host runtime; docker = read-only Docker ping
RUNTIME_MODE=preview
# Host runtime mutations are OFF by default. Set true only on a trusted Linux host with CAP_NET_ADMIN.
HOST_RUNTIME_ALLOW_MUTATIONS=false
# Keep server configs in a private directory; default: /etc/amnezia-panel/interfaces
HOST_RUNTIME_CONFIG_DIR=/etc/amnezia-panel/interfaces
RUST_LOG=info

# 32-byte installation master key, encoded as 64 hexadecimal characters.
# Generate once with: openssl rand -hex 32
# Keep it outside the database and back it up securely. Losing it makes stored private keys unrecoverable.
WIREGUARD_MASTER_KEY=
